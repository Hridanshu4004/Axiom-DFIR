# ==============================================================================
# AXIOM DFIR: Environment Configuration Template
# Target: Nebius x NVIDIA Global AI Hackathon 2026 (Best Apps & Agents Track)
# ==============================================================================

# 1. Primary Inference Provider (Nebius Token Factory with NVIDIA Nemotron)
AXIOM_LLM_PROVIDER=nebius

# 2. Nebius Token Factory Credentials & Regional Endpoint
# Obtain your API key from Nebius Token Factory: https://docs.tokenfactory.nebius.com/
# Leave blank to run in 100% functional zero-credential synthetic demonstration mode
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Alternative Central US Regional Endpoint:
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# 3. Model Profiles (Nebius Token Factory)
# FAST PROFILE (Log parsing, triage, tool selection proposals, low complexity)
AXIOM_FAST_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# BALANCED PROFILE (Structured hypothesis generation, tool parameter construction)
AXIOM_BALANCED_MODEL=nvidia/nemotron-mini-4b-instruct

# DEEP PROFILE (Deep hypothesis generation, root-cause lateral movement analysis, conflicting evidence)
AXIOM_DEEP_MODEL=nvidia/nemotron-4-340b-instruct

# 4. Optional External Threat Intelligence Enrichment (Tavily API)
# Strictly airgapped and labeled as EXTERNAL_THREAT_INTEL
TAVILY_API_KEY=

# 5. Offline / Synthetic Testing Switch
# Automatically set to 1 when NEBIUS_API_KEY is not provided
AXIOM_MOCK_NEBIUS=0
AXIOM_DEMO_MODE=false

# 6. Network & Request Timeouts
AXIOM_HTTP_TIMEOUT=120
AXIOM_MAX_OUTPUT_TOKENS=8192

# 7. Production Web Console & REST API Configuration
AXIOM_WEB_PORT=8000
AXIOM_WEB_HOST=127.0.0.1
